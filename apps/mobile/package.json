  "dependencies": {
    "@lyrics-companion/core": "file:../../packages/core",
    "expo": "~57.0.26",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-keep-awake": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
